{
  "manifest_version": 3,
  "name": "English Frequency Highlighter",
  "version": "0.1",
  "description": "Highlight frequent words and estimate coverage",
  "permissions": ["scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "exclude_matches": [
        "https://www.google.com/*",
        "https://www.youtube.com/*",
        "https://mail.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["words.json"],
      "matches": ["<all_urls>"]
    }
  ]
}